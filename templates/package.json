{
  "name": "3d-film-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Three.js film starter: window.renderFrame(n) + puppeteer-core + ffmpeg, frame-exact.",
  "scripts": {
    "serve": "node serve.mjs 8080",
    "render": "node render.mjs",
    "stills": "node render.mjs --stills 0,30,60,75,90,120,149",
    "qc": "bash scripts/qc.sh out/film.mp4 150"
  },
  "dependencies": {
    "puppeteer-core": "23.10.4",
    "three": "0.170.0"
  },
  "engines": { "node": ">=18" }
}
